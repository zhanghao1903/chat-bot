# Required. Obtain this from BotFather and keep the real value outside git.
TELEGRAM_BOT_TOKEN=

# Required. Negative numeric ID of the one allowed Telegram group/supergroup.
TELEGRAM_CHAT_ID=

# Optional runtime settings.
DATABASE_PATH=data/telegram_bot.sqlite3
TELEGRAM_POLLING_TIMEOUT_SECONDS=25
TELEGRAM_RETRY_DELAY_SECONDS=2
LOG_LEVEL=INFO

# Compatibility default. Use persona_direct or persona_full only with a confirmed bundle.
BOT_MODE=fixed
PERSONA_BUNDLE_PATH=
PERSONA_EXPECTED_SHA256=

# Required only in persona modes.
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
WRITER_MODEL=
TRIGGER_MODEL=
RECOGNITION_MODEL=
VISION_CAPABILITY=disabled
VISION_MODEL=
VISION_TIMEOUT_SECONDS=15
MEDIA_MAX_DOWNLOAD_BYTES=8388608
MEDIA_MAX_PIXELS=12000000

# Keep disabled until preview, upload, and Telegram smoke gates pass.
EXPRESSION_CAPABILITY=disabled
EXPRESSION_CATALOG_PATH=
EXPRESSION_CATALOG_SHA256=

# Availability does not enable persistence; an administrator must run /memory_enable.
MEMBER_MEMORY_CAPABILITY=disabled
RAW_MESSAGE_RETENTION_DAYS=7
EFFECT_MAX_MODEL_CALLS=12
EFFECT_ORDINARY_TOOL_CALLS=3
EFFECT_MAX_TOOL_CALLS=5
WEB_TOOL_LIMIT=5
TOOL_RESULT_TOTAL_CHARS=16384
EFFECT_DEADLINE_SECONDS=20
TRIGGER_DECISION_TIMEOUT_SECONDS=5
RECOGNITION_TIMEOUT_SECONDS=15
RECOGNITION_MAX_ATTEMPTS=3

# Scheduled food automation is inert until both the runtime capability and the group are enabled.
AUTOMATION_CAPABILITY=disabled
AUTOMATION_TICK_SECONDS=15
SCHEDULED_EFFECT_DEADLINE_SECONDS=60

# Tavily Search/Extract is an independent, optional read-only capability.
TAVILY_WEB_CAPABILITY=disabled
TAVILY_API_KEY=
TAVILY_PROJECT_ID=
TAVILY_TIMEOUT_SECONDS=8
