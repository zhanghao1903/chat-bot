# Required. Obtain this from BotFather and keep the real value outside git.
TELEGRAM_BOT_TOKEN=

# Required. Negative numeric ID of the one allowed Telegram group/supergroup.
TELEGRAM_CHAT_ID=

# Optional runtime settings.
DATABASE_PATH=data/telegram_bot.sqlite3
TELEGRAM_POLLING_TIMEOUT_SECONDS=25
TELEGRAM_RETRY_DELAY_SECONDS=2
LOG_LEVEL=INFO
