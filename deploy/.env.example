# Copy to deploy/.env and fill the operator-owned credentials and model identifiers.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_DATA_VOLUME=telegram-bot-data
DATABASE_PATH=/app/data/telegram_bot.sqlite3

TELEGRAM_POLLING_TIMEOUT_SECONDS=25
TELEGRAM_RETRY_DELAY_SECONDS=2
LOG_LEVEL=INFO

BOT_MODE=fixed
# Production example and rollback point. Activation requires an exact version and digest.
PERSONA_BUNDLE_PATH=/app/src/group_llm_agent/persona_bundles/lezhi/lezhi-v1.0
PERSONA_EXPECTED_SHA256=25af6db13d2a9d4702a167ed99c685d3e934c6436eca491ce7de2ee58907a72a

MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
WRITER_MODEL=
TRIGGER_MODEL=
RECOGNITION_MODEL=
VISION_CAPABILITY=disabled
VISION_MODEL=
VISION_TIMEOUT_SECONDS=15
MEDIA_MAX_DOWNLOAD_BYTES=8388608
MEDIA_MAX_PIXELS=12000000

# Production remains disabled until the separately confirmed catalog is Telegram-ready.
EXPRESSION_CAPABILITY=disabled
EXPRESSION_CATALOG_PATH=/app/src/group_llm_agent/expression_assets/lezhi/lezhi-expression-v0.3/catalog.json
EXPRESSION_CATALOG_SHA256=

MEMBER_MEMORY_CAPABILITY=disabled
RAW_MESSAGE_RETENTION_DAYS=7
EFFECT_MAX_MODEL_CALLS=12
EFFECT_ORDINARY_TOOL_CALLS=3
EFFECT_MAX_TOOL_CALLS=5
WEB_TOOL_LIMIT=5
TOOL_RESULT_TOTAL_CHARS=16384
EFFECT_DEADLINE_SECONDS=20
TRIGGER_DECISION_TIMEOUT_SECONDS=5
RECOGNITION_TIMEOUT_SECONDS=15
RECOGNITION_MAX_ATTEMPTS=3

# Capability availability does not enable a group or create member subscriptions.
AUTOMATION_CAPABILITY=disabled
AUTOMATION_TICK_SECONDS=15
SCHEDULED_EFFECT_DEADLINE_SECONDS=60

# Optional Tavily Search/Extract. Keep disabled until an operator authorizes a real probe.
TAVILY_WEB_CAPABILITY=disabled
TAVILY_API_KEY=
TAVILY_PROJECT_ID=
TAVILY_TIMEOUT_SECONDS=8
